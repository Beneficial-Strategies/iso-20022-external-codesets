// The external code sets host, https://iso-20022-external-codesets.beneficialstrategies.com: ISO's lists, one JSON file per code set, served as static
// assets (no Worker code). Cloudflare Workers Builds watches this repository: the main branch deploys, other branches get preview addresses.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iso-20022-external-codesets",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site" },
  // DNS record and certificate are made on deploy; the name is one level below the zone (the free certificate covers *.beneficialstrategies.com)
  "routes": [{ "pattern": "iso-20022-external-codesets.beneficialstrategies.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // preview builds do not run the dashboard's build command, so the site is built here
  "build": { "command": "node tools/build.mjs --out site" },
  "previews": {}
}
